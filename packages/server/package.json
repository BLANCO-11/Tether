{
  "name": "@foundry/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/demo/*.sql dist/demo/ && cp src/demo/alt/*.sql dist/demo/alt/ && cp src/demo/finance/*.sql dist/demo/finance/ && cp src/demo/legal/*.sql dist/demo/legal/ && cp src/demo/itops/*.sql dist/demo/itops/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "demo:verify": "tsx src/demo/verify-dataset.ts",
    "demo:seed": "tsx src/demo/cli.ts provision",
    "mail:register": "tsx src/services/platform-tool-cli.ts",
    "platform:tools": "tsx src/services/platform-tool-cli.ts",
    "runtime-model:import": "tsx src/services/runtime-model-import.ts",
    "demo:reset": "tsx src/demo/cli.ts reset",
    "demo:status": "tsx src/demo/cli.ts status",
    "demo:seed-alt": "tsx src/demo/cli.ts provision-alt",
    "finance:seed": "tsx src/demo/cli.ts provision-finance",
    "finance:verify": "tsx src/demo/finance/verify-finance.ts",
    "legal:seed": "tsx src/demo/cli.ts provision-legal",
    "legal:verify": "tsx src/demo/legal/verify-legal.ts",
    "itops:seed": "tsx src/demo/cli.ts provision-itops",
    "itops:verify": "tsx src/demo/itops/verify-itops.ts",
    "itops:scenarios": "tsx src/scenarios/itops-seed.ts",
    "itops:scenarios-verify": "tsx src/scenarios/itops-verify.ts",
    "arms:verify": "tsx src/scenarios/arms-verify.ts",
    "ambiguity:measure": "tsx src/scenarios/ambiguity-measure.ts",
    "generic:flows": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/generic-seed.ts",
    "generic:seed": "tsx src/demo/generic/seed.ts",
    "hr:demo-flows": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/hr-demo-seed.ts",
    "slate:plan": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/fresh-slate.ts",
    "slate:clear": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/fresh-slate.ts clear",
    "tenants:plan": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/fresh-tenants.ts",
    "tenants:clear": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/fresh-tenants.ts clear",
    "tidy:plan": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/tidy-litter.ts",
    "tidy:clear": "eval \"$(../../scripts/server-env.sh)\" && tsx src/demo/tidy-litter.ts clear",
    "demo:rehearse": "vitest run src/demo/alt/swap-rehearsal.test.ts",
    "e2e:ui": "tsx src/kestra/e2e-ui-journey.ts",
    "showcase:seed": "eval \"$(../../scripts/server-env.sh)\" && tsx src/showcase/seed.ts",
    "showcase:verify": "eval \"$(../../scripts/server-env.sh)\" && tsx src/showcase/verify.ts",
    "scenarios:seed": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/seed.ts",
    "scenarios:verify": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/verify.ts",
    "typecheck:report": "tsx src/scenarios/typecheck-report.ts",
    "heldout:seed": "tsx src/demo/heldout/seed.ts",
    "heldout:verify": "tsx src/demo/heldout/verify.ts",
    "builder:measure": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/builder-measure.ts",
    "builder:converse": "tsx src/scenarios/builder-converse.ts",
    "builder:proto": "tsx src/scenarios/builder-proto.ts",
    "builder:proto:batch": "tsx src/scenarios/builder-proto-batch.ts",
    "builder:replay": "tsx src/scenarios/builder-replay.ts",
    "chat:x-measure": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/chat-x-measure.ts",
    "chat:humanlike": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/chat-humanlike-measure.ts",
    "uat:say": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/uat-say.ts",
    "uat:run": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/uat-run.ts",
    "uat:domains": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/uat-domains.ts",
    "chat:components": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/chat-components.ts",
    "fingerprint:measure": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/fingerprint-measure.ts",
    "propose:measure": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/propose-measure.ts",
    "foreach:e2e": "../../scripts/harness-in-net.sh packages/server/src/scenarios/foreach-e2e.ts",
    "kestra:refusal": "eval \"$(../../scripts/server-env.sh)\" && tsx src/kestra/refusal-verify.ts",
    "sandbox:status": "tsx src/sandbox/cli.ts status",
    "sandbox:provision": "tsx src/sandbox/cli.ts provision",
    "sandbox:rebuild": "tsx src/sandbox/cli.ts rebuild",
    "mock:rebuild": "tsx src/scenarios/mock-rebuild.ts",
    "sandbox:teardown": "tsx src/sandbox/cli.ts teardown",
    "signals": "eval \"$(../../scripts/server-env.sh)\" && tsx src/kestra/signals-check.ts",
    "catalogue:seed": "tsx src/scenarios/catalogue-seed.ts",
    "catalogue:flows": "tsx src/scenarios/catalogue-flows.ts",
    "api:addresses": "tsx src/scenarios/api-addresses.ts",
    "seed:all": "pnpm demo:seed && pnpm demo:seed-alt && pnpm finance:seed && pnpm legal:seed && pnpm itops:seed && pnpm generic:seed && pnpm catalogue:seed",
    "rbac:backfill": "tsx src/scripts/rbac-backfill.ts",
    "rbac:verify": "tsx src/scripts/rbac-verify.ts",
    "rbac:platform-verify": "tsx src/scripts/rbac-platform-verify.ts",
    "blob:count": "tsx src/scenarios/blob-binding-count.ts",
    "legacy:compile": "eval \"$(../../scripts/server-env.sh)\" && tsx src/scenarios/legacy-compile-diff.ts",
    "test:db": "tsx src/db/prepare-test-db.ts",
    "people:tidy": "tsx src/scripts/people-tidy.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@foundry/flow-edit": "workspace:*",
    "@foundry/redact": "workspace:*",
    "@foundry/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "jose": "^5.10.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "unpdf": "1.4.0",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
