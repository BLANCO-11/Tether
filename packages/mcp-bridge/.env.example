# Foundry MCP Bridge — copy to .env for standalone local runs.
# When run via infra/docker-compose.yml, this value is instead passed through
# from the repo root's .env (see its MCP_BRIDGE_API_KEY entry).

MCP_BRIDGE_PORT=4003

# Required. Every request except GET /health must present this value as the
# x-api-key header. Unset -> every request is refused (fail closed), never
# treated as anonymous or unauthenticated-but-allowed.
MCP_BRIDGE_API_KEY=dev-mcp-bridge-key

# Required, and deliberately NOT defaulted in code any more: `schema-store.ts`
# used to fall back to exactly this string, so a deployment that never set it got
# the parent database's OWNER credential — one query from `workspace_secrets` —
# instead of a startup error. The bridge reads `schemas` and `datasources` only,
# so point it at a least-privilege role in any deployment that matters.
DATABASE_URL=postgres://foundry:foundry@localhost:5433/foundry_parent
