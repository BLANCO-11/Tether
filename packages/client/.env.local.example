# Foundry Parent App — web client (copy to .env.local)
#   cp packages/client/.env.local.example packages/client/.env.local

# ── Auth.js (NextAuth v5) ──
# AUTH_URL must match the client's dev origin (login cookies key off it).
AUTH_URL=http://localhost:4002
# Generate: openssl rand -base64 33
AUTH_SECRET=replace-me
# Local sign-in is shown in every environment (production too) for the accounts created
# under Organization; set LOCAL_LOGIN=off to hide it. The env super-admin below is
# enabled by LOCAL_ADMIN_PASSWORD; it is granted the `superadmin` role in src/auth.ts.
LOCAL_ADMIN_EMAIL=superadmin@foundry.local
LOCAL_ADMIN_NAME=Super Admin
LOCAL_ADMIN_PASSWORD=replace-me
# Optional Microsoft Entra ID SSO (leave blank in dev → provider self-disables).
#
# ⚠ SET ALL THREE HERE, OR NONE. This file OUTRANKS the repo-root `.env` on both
# load paths — Compose lists it after `../.env` in the `web` service, and host-mode
# `next dev` runs with cwd = packages/client, where `.env.local` is the highest
# precedence file and the repo-root `.env` is not read at all. So a value present
# in BOTH files always resolves to this one, and real credentials in `../../.env`
# are silently shadowed by whatever is written here.
#
# ⚠ AND THE ISSUER IS NOT OPTIONAL ONCE ID/SECRET ARE SET. It does two jobs:
# `auth.ts` derives ALLOWED_TENANT_ID from its <TENANT_ID> segment (the signIn
# callback returns true unqualified when that is undefined — the tenant pin turns
# OFF rather than failing closed), and NextAuth routes the authorize request at it.
# Unset, the request goes to the multi-tenant common endpoint, Microsoft resolves
# the signed-in account's own home tenant, and the failure is `AADSTS700016:
# Application with identifier '<id>' was not found in the directory '<a tenant you
# never configured>'` — which reads as a wrong client id and is a missing issuer.
# Both halves cost a real debugging session on 2026-08-18.
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Set this only to override the tenant derived from the issuer above.
# AUTH_ALLOWED_TENANT_ID=

# ── Server seam (packages/server on :4000) ──
# Server-side only (NEVER prefixed NEXT_PUBLIC) — the parent API key stays off
# the browser; Server Components / Server Actions / Route Handlers call the API.
PARENT_API_URL=http://localhost:4000
PARENT_API_KEY=dev-parent-key

# ── Live run-progress WebSocket ──
# NEXT_PUBLIC_WS_URL is GONE. It pointed at `/ws/generation`, which Phase 4
# deleted with the monolithic path — and which was authorised by nothing at all: a
# `?scriptId=<uuid>` and you were subscribed. Do not reintroduce that shape.
#
# The surviving channel is `/ws/flow-execution` and it is NOT NEXT_PUBLIC. Baking
# a socket URL into the browser bundle means a redeploy needs a rebuild; this one
# is served at REQUEST time via /api/foundry-config. Authorisation is a single-use
# 60s ticket bound to one (workspace, execution), minted by an API-key-authenticated
# route — the browser never holds PARENT_API_KEY (the /api/foundry proxy injects it
# server-side, and a WebSocket cannot use that proxy). See D-15.
#
# Unset it and /runs/[id] polls instead: same server-side assembly, slower.
FOUNDRY_WS_URL=ws://localhost:4001

# ── Which workspace the UI binds to ──
# Read at request time via /api/foundry-config, so changing it needs a restart,
# not a rebuild. Without it the UI falls back to the OLDEST workspace — never the
# newest, because that made creating a workspace silently repoint the whole UI.
FOUNDRY_WORKSPACE=HR
